<!-- res/drawable/rounded_layout_bg.xml -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- 设置圆角半径 -->
    <corners android:radius="5dp" />   <!-- 统一设置四个角 -->
    <!-- 也可以单独设置每个角，如下所示 -->
    <!--
    android:topLeftRadius="10dp"
    android:topRightRadius="10dp"
    android:bottomLeftRadius="5dp"
    android:bottomRightRadius="5dp"
    -->


    <!-- 设置背景填充色 -->
    <solid android:color="#FFFFFF" /> <!-- 白色背景 -->

    <!-- 可选：设置描边（边框） -->
    <!-- 淡灰色边框 -->
<!--    <stroke-->
<!--        android:width="2dp"-->
<!--        android:color="#D30D2D" />-->

    <!-- 可选：设置内边距 -->
    <padding
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp" /> <!-- 可根据需要调整 -->
</shape>
